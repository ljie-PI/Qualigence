{
  "name": "qualigence",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @qualigence/web-console run build",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && vitest run tests/e2e",
    "test:live": "pnpm build && vitest run tests/live",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.test.json && pnpm --filter @qualigence/web-console run typecheck",
    "smoke:node-imports": "pnpm build && node tests/smoke/node-package-imports.mjs",
    "companion:build": "cargo build --manifest-path apps/companion/Cargo.toml",
    "companion:test": "cargo test --manifest-path apps/companion/Cargo.toml",
    "gate:companion": "cargo fmt --manifest-path apps/companion/Cargo.toml --check && cargo build --manifest-path apps/companion/Cargo.toml && cargo test --manifest-path apps/companion/Cargo.toml",
    "benchmark:detection": "pnpm build && node apps/benchmark-runner/dist/main.js run --manifest benchmarks/detection-v1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@bufbuild/buf": "^1.72.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.15",
    "@qualigence/application-model": "workspace:*",
    "@qualigence/admin-cli": "workspace:*",
    "@qualigence/artifact-fs": "workspace:*",
    "@qualigence/artifact-s3": "workspace:*",
    "@qualigence/benchmark-runner": "workspace:*",
    "@qualigence/benchmarking-detection": "workspace:*",
    "@qualigence/cli": "workspace:*",
    "@qualigence/context-intake": "workspace:*",
    "@qualigence/core-application": "workspace:*",
    "@qualigence/core-daemon": "workspace:*",
    "@qualigence/desktop-contracts": "workspace:*",
    "@qualigence/desktop-windows-uia": "workspace:*",
    "@qualigence/evidence": "workspace:*",
    "@qualigence/evidence-capsule": "workspace:*",
    "@qualigence/execution-application": "workspace:*",
    "@qualigence/exploration": "workspace:*",
    "@qualigence/grpc-runner-protocol": "workspace:*",
    "@qualigence/in-memory-runner-protocol": "workspace:*",
    "@qualigence/intelligence": "workspace:*",
    "@qualigence/intelligence-worker": "workspace:*",
    "@qualigence/investigation": "workspace:*",
    "@qualigence/kms-local": "workspace:*",
    "@qualigence/kms-self-hosted": "workspace:*",
    "@qualigence/local-control": "workspace:*",
    "@qualigence/local-launcher": "workspace:*",
    "@qualigence/mission": "workspace:*",
    "@qualigence/model-agent": "workspace:*",
    "@qualigence/model-gateway": "workspace:*",
    "@qualigence/model-provider": "workspace:*",
    "@qualigence/observability": "workspace:*",
    "@qualigence/observation-contracts": "workspace:*",
    "@qualigence/observation-migration": "workspace:*",
    "@qualigence/openai-compatible-model-provider": "workspace:*",
    "@qualigence/public-api": "workspace:*",
    "@qualigence/oidc": "workspace:*",
    "@qualigence/postgres-runtime": "workspace:*",
    "@qualigence/project-target": "workspace:*",
    "@qualigence/recording": "workspace:*",
    "@qualigence/review": "workspace:*",
    "@qualigence/runner": "workspace:*",
    "@qualigence/server": "workspace:*",
    "@qualigence/runner-identity": "workspace:*",
    "@qualigence/relational-kysely": "workspace:*",
