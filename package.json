{
  "name": "qualigence",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && vitest run tests/e2e",
    "test:live": "pnpm build && vitest run tests/live",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.test.json",
    "smoke:node-imports": "pnpm build && node tests/smoke/node-package-imports.mjs"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.15",
    "@qualigence/application-model": "workspace:*",
    "@qualigence/artifact-fs": "workspace:*",
    "@qualigence/context-intake": "workspace:*",
    "@qualigence/cli": "workspace:*",
    "@qualigence/core-daemon": "workspace:*",
    "@qualigence/evidence": "workspace:*",
    "@qualigence/execution-application": "workspace:*",
    "@qualigence/grpc-runner-protocol": "workspace:*",
    "@qualigence/in-memory-runner-protocol": "workspace:*",
    "@qualigence/local-control": "workspace:*",
    "@qualigence/local-launcher": "workspace:*",
    "@qualigence/mission": "workspace:*",
    "@qualigence/model-agent": "workspace:*",
    "@qualigence/model-gateway": "workspace:*",
    "@qualigence/model-provider": "workspace:*",
    "@qualigence/openai-compatible-model-provider": "workspace:*",
    "@qualigence/recording": "workspace:*",
    "@qualigence/runner-kernel": "workspace:*",
    "@qualigence/runner-identity": "workspace:*",
    "@qualigence/runner-mtls": "workspace:*",
    "@qualigence/runner": "workspace:*",
    "@qualigence/runner-protocol": "workspace:*",
    "@qualigence/runner-spool": "workspace:*",
    "@qualigence/shared-kernel": "workspace:*",
    "@qualigence/skill": "workspace:*",
    "@qualigence/sqlite-runtime": "workspace:*",
    "@qualigence/testkit": "workspace:*",
    "@qualigence/web-playwright": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/better-sqlite3": "9.6.0",
    "better-sqlite3": "12.11.1",
    "fastify": "^5.11.0",
    "typescript": "^5.9.0 || ^6.0.0",
    "vitest": "^4.0.0"
  }
}
