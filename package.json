    "@qualigence/skill-replay": "workspace:*",
    "@qualigence/sqlite-runtime": "workspace:*",
    "@qualigence/testkit": "workspace:*",
    "@qualigence/web-console": "workspace:*",
    "@qualigence/web-playwright": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.11.10",
    "better-sqlite3": "12.11.1",
    "fastify": "^5.11.0",
    "kysely": "0.28.17",
