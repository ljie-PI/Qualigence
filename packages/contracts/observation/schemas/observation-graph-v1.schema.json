{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualigence.dev/schemas/observation-graph-v1.schema.json",
  "title": "Observation Graph v1 (candidate)",
  "description": "Candidate cross-platform Observation Graph contract. Status: candidate — NOT frozen until LS-13 Web/UIA conformance passes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "graphId", "target", "capturedAt", "rootNodeIds", "nodes", "evidenceRefs"],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "version"],
      "properties": {
        "epoch": { "const": "v1" },
        "version": { "const": "observation-graph/v1" }
      }
    },
    "graphId": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetId"],
      "properties": {
        "kind": { "enum": ["web", "app"] },
        "targetId": { "type": "string", "minLength": 1 }
      }
    },
    "capturedAt": { "type": "string", "minLength": 1 },
    "rootNodeIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*/v[0-9]+$" },
      "additionalProperties": { "$ref": "#/$defs/extension" },
      "properties": {
        "web/v1": { "$ref": "#/$defs/webExtensionV1" }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "state", "relations", "source", "confidence", "sensitivity", "extensions", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "string" },
        "state": {
          "type": "object",
          "additionalProperties": { "type": ["boolean", "string", "number"] }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapterId", "sourceKind"],
          "properties": {
            "adapterId": { "type": "string", "minLength": 1 },
            "sourceKind": { "type": "string", "minLength": 1 }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sensitivity": { "enum": ["public", "internal", "sensitive", "secret"] },
        "extensions": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*/v[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/extension" }
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetNodeId"],
      "properties": {
        "type": { "enum": ["child", "labelled_by", "described_by", "controls", "owns", "focuses"] },
        "targetNodeId": { "type": "string", "minLength": 1 }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "payload"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "setSemantics": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/.+" }
        },
        "payload": { "type": "object" }
      }
    },
    "webExtensionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "payload"],
      "properties": {
        "type": { "const": "web/v1" },
        "version": { "type": "string", "minLength": 1 },
        "setSemantics": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/.+" }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "pathname", "title", "viewport", "query"],
          "properties": {
            "origin": { "type": "string", "pattern": "^https?://[^/?#]+$" },
            "pathname": { "type": "string", "pattern": "^/[^?#]*$" },
            "title": { "type": "string" },
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height", "devicePixelRatio"],
              "properties": {
                "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
                "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
                "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 16 }
              }
            },
            "query": {
              "type": "object",
              "additionalProperties": { "const": "[redacted]" }
            }
          }
        }
      }
    }
  }
}
