# Qualigence Self-hosted — non-secret deployment configuration.
#
# Copy to `.env` and adjust. This file MUST NOT contain secret values; all
# secrets are mounted from files under ./secrets (see secrets/README.md).

# Image tag built from this repository (see README.md for the build command).
QUALIGENCE_IMAGE_TAG=0.1.0

# Public HTTPS bind address for the reverse proxy (host:port or :port).
QUALIGENCE_SITE_ADDRESS=:443

# OIDC issuer + audience your Server validates access tokens against. These are
# non-secret identifiers (the signing keys are mounted as the oidc_jwks secret).
QUALIGENCE_OIDC_ISSUER=https://issuer.example.com
QUALIGENCE_OIDC_AUDIENCE=qualigence-self-hosted

# Intelligence model endpoint the Worker calls. The API key itself is the
# worker_model_api_key secret, never set here.
QUALIGENCE_MODEL_BASE_URL=https://models.example.com/v1
QUALIGENCE_MODEL_NAME=qualigence-analyst
