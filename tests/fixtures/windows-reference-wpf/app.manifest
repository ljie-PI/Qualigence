<?xml version="1.0" encoding="utf-8"?>
<!--
  The WPF Reference App runs with the ordinary interactive user's rights. It never
  requests elevation and never uses UIAccess: the Companion's own manifest also
  fixes uiAccess=false, and the acceptance run verifies neither side bypasses UIPI.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
