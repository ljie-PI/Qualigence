<!--
  The single reference window. Every interactive control carries a stable
  AutomationId so a UIA capture produces a deterministic, re-resolvable tree that
  matches reference-app.fixture.json. AutomationIds are the contract the manual
  Windows-11 run verifies against the synthetic fixture the Linux suite uses.
-->
<Window x:Class="WindowsReferenceWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reference App"
        AutomationProperties.AutomationId="MainWindow"
        Width="480" Height="520">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 x:Name="UsernameEdit"
                 AutomationProperties.AutomationId="UsernameEdit"
                 AutomationProperties.Name="Username" />

        <PasswordBox Grid.Row="1"
                     x:Name="PasswordEdit"
                     AutomationProperties.AutomationId="PasswordEdit"
                     AutomationProperties.Name="Password" />

        <ComboBox Grid.Row="2"
                  x:Name="RoleCombo"
                  AutomationProperties.AutomationId="RoleCombo"
                  AutomationProperties.Name="Role">
            <ComboBoxItem Content="Viewer" />
            <ComboBoxItem Content="Editor" />
            <ComboBoxItem Content="Admin" />
        </ComboBox>

        <Button Grid.Row="3"
                x:Name="SubmitButton"
                AutomationProperties.AutomationId="SubmitButton"
                AutomationProperties.Name="Submit"
                Click="OnSubmit" />

        <ScrollViewer Grid.Row="4"
                      AutomationProperties.AutomationId="ResultsScroll"
                      VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="ResultsList"
                     AutomationProperties.AutomationId="ResultsList"
                     AutomationProperties.Name="Results" />
        </ScrollViewer>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <!-- Simulated high-risk action: requires per-action local approval. -->
            <Button x:Name="DeleteAllButton"
                    AutomationProperties.AutomationId="DeleteAllButton"
                    AutomationProperties.Name="Delete all records"
                    Click="OnDeleteAll" />
            <!-- Controlled crash entry for deterministic crash-Finding coverage. -->
            <Button x:Name="CrashButton"
                    AutomationProperties.AutomationId="CrashButton"
                    AutomationProperties.Name="Trigger crash"
                    Click="OnCrash" />
            <!-- Reset to the known initial state from local JSON. -->
            <Button x:Name="ResetButton"
                    AutomationProperties.AutomationId="ResetButton"
                    AutomationProperties.Name="Reset"
                    Click="OnReset" />
        </StackPanel>
    </Grid>
</Window>
